  "cards": [
    {
      "dot": "cyan",
      "title": "主路径",
      "items": [
        "CLI 选定标的、日期和分析师后，交易图编译 LangGraph 并流式执行",
        "市场、情绪、新闻、基本面同时开工；四份报告齐了才进入多空辩论",
        "研究经理给出计划，交易员拟定方案，风险三方轮转结束后组合经理给出五档评级"
      ]
    },
    {
      "dot": "emerald",
      "title": "数据边界",
      "items": [
        "带日期的工具把窗口截断到 trade_date，不读取更晚的数据",
        "默认行情走 Yahoo，财报先 SEC EDGAR 再 Yahoo，宏观走 FRED，预测市场走 Polymarket",
        "只回退到 data_vendors 里写明的供应商；情绪岗直接拉 StockTwits 和 Reddit，有 TYPESAFE_API_KEY 时先用 Jev 筛帖"
      ]
    },
    {
      "dot": "amber",
      "title": "落盘与回测",
      "items": [
        "开跑前结算并读入该标的已到期教训，结束后把决策追加进记忆日志",
        "checkpoint_enabled 时按标的写入 SQLite，成功跑完后清除；默认关闭",
        "报告树和 full_states_log 由交易图写入 results_dir；回测对日期网格重复调用同一 propagate，格子之间不结转持仓"
      ]
    }
  ]
