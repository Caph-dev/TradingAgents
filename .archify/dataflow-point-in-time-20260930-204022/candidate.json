  "cards": [
    {
      "dot": "rose",
      "title": "运行日是最终上界",
      "items": [
        "trade_date 经 InjectedState 注入，不出现在模型可见的工具参数里",
        "模型只能把窗口收窄，as_of 会把更晚的请求钳回分析日"
      ]
    },
    {
      "dot": "amber",
      "title": "不能回答就抑制",
      "items": [
        "实时概况、无填报日的报表和内部交易，在历史运行里发请求前就返回说明",
        "EDGAR 因每笔事实带 filed，可以按申报日服务，而不是整类抑制"
      ]
    },
    {
      "dot": "emerald",
      "title": "教训也有可知时间",
      "items": [
        "历史运行只注入 resolved 日期不晚于分析日的条目",
        "当日运行传 as_of=None，不过滤实时记忆"
      ]
    }
